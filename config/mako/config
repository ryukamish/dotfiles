include=~/.config/mako/colors.ini

# Global settings
font=JetBrainsMono Nerd Font 12
width=350
margin=10
padding=10
border-size=2
border-radius=5
default-timeout=5000
ignore-timeout=0
max-visible=3
layer=overlay
anchor=top-right

[urgency=low]
default-timeout=5000

[urgency=normal]
default-timeout=10000

[urgency=high]
default-timeout=50000
