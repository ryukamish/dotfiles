* {
    foreground: #DCD7BA;
    background: #1F1F28;

    color1: #FF5D62;
    color2: #7AA89F;
    color3: #E6C384;
    color4: #7E9CD8;
}

window {
    border-color: @color3;
}

element.selected.normal {
    background-color: @color2;
}

element.alternate.normal {
    background-color: transparent;
}

element-text.selected {
    text-color:       @background;
}

element-text.selected.urgent {
    text-color:       @color1;
}
