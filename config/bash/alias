if command -v eza >/dev/null; then
  alias ls='eza -l --icons --group-directories-first'
fi

# neovim alias
alias nv='nvim'

# cd alias
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# package management
alias s='pacman -Ss'
alias si='sudo pacman -S'
alias y='yay -Ss'
alias yi='yay -S'
